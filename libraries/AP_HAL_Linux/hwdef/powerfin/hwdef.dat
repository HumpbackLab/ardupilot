# Humpback PowerFin, OpenHarmony musl on Cortex-A7
env TOOLCHAIN arm-linux-musleabihf

define CONFIG_HAL_BOARD_SUBTYPE HAL_BOARD_SUBTYPE_LINUX_POWERFIN

IMU SC7U22IIO ROTATION_ROLL_180_YAW_90

# The on-board SC7U22 is exposed by the Linux IIO driver.
define HAL_LINUX_I2C_INTERNAL_BUS_MASK 1 << 0
define HAL_LINUX_I2C_EXTERNAL_BUS_MASK 1 << 1

COMPASS QMC5883P I2C:0:0x2c false ROTATION_NONE
BARO SPL06 I2C:0:0x77

LINUX_SPIDEV "osd" 1 1 SPI_MODE_0 8 SPI_CS_KERNEL 1*MHZ 10*MHZ
define HAL_WITH_SPI_OSD 1
define HAL_OSD_TYPE_DEFAULT 1

define AP_BATTERY_ANALOG_ENABLED AP_BATTERY_BACKEND_DEFAULT_ENABLED
define HAL_BATT_MONITOR_DEFAULT AP_BattMonitor::Type::ANALOG_VOLTAGE_ONLY
define HAL_BATT_VOLT_PIN 0
define HAL_BATT_VOLT_SCALE 1.0f
define HAL_BATT_CURR_PIN -1
define HAL_BATT_CURR_SCALE 0.0f

define HAL_BOARD_LOG_DIRECTORY "logs"
define HAL_BOARD_TERRAIN_DIRECTORY "terrain"
define HAL_BOARD_STORAGE_DIRECTORY "."
